# Vercel Environment Variables Example
# Copy this file to .env.local and fill in your credentials

# ExpressPay API
EXPRESSAY_API_KEY=sk_test_your_expresspay_key

# FusionPay API
FUSIONPAY_API_KEY=sk_test_your_fusionpay_key

# Wintech Payments
WINTECH_PUBLIC_KEY=your_wintech_public_key
WINTECH_SECRET_KEY=your_wintech_secret_key

# GestãoPay
GESTAOPAY_PUBLIC_KEY=gestaopay_live_xxxxx
GESTAOPAY_SECRET_KEY=sk_live_xxxxx

# Debug mode (0 or 1)
DEBUG=0
