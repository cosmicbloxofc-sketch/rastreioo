{
  "redirects": [
    {
      "source": "/pagamento/:file(.*)\\.php",
      "destination": "/pagamento",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/consulta.php",
      "destination": "/api/consulta.php"
    },
    {
      "source": "/api/consulta",
      "destination": "/api/consulta.php"
    },
    {
      "source": "/api/pagamento",
      "destination": "/api/pagamento.php"
    },
    {
      "source": "/pagamento/api.php",
      "destination": "/api/pagamento.php"
    },
    {
      "source": "/pagamento",
      "destination": "/api/pagamento-page.php"
    },
    {
      "source": "/pagamento/",
      "destination": "/api/pagamento-page.php"
    },
    {
      "source": "/pagamento/index.php",
      "destination": "/api/pagamento-page.php"
    },
    {
      "source": "/api/webhook_gestaopay",
      "destination": "/api/webhook_gestaopay.php"
    },
    {
      "source": "/api/webhook_invictus",
      "destination": "/api/webhook_invictus.php"
    }
  ],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  }
}
